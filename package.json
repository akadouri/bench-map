{
  "name": "benches",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:types-generated && npm run type-check && npm run build-only",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types-generated": "node scripts/generate-types.mjs --check",
    "schemas:sync": "bash scripts/sync-schemas.sh",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:s3mock": "vitest run tests/integration/Parks.s3mock.test.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1",
    "mitt": "^3.0.0",
    "pmtiles": "^4.3.0",
    "vite": "^6.0.6",
    "vue": "^3.2.45",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/node": "^18.11.12",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.0.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^2.7.1",
    "sass": "^1.57.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.2.5"
  }
}
